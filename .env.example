# Copy to .env and fill in. Every key below mirrors a field on Settings in
# app/config.py; anything left out falls back to the default defined there.
# Values shown are the defaults unless marked CHANGE_ME.
#
# On Render (or any managed host) set these as environment variables on the
# service rather than shipping a .env file — environment variables take
# precedence over the file.

# ---- App ----
APP_NAME=WhatsApp Commerce
# development | staging | production. Setting "production" turns off /docs,
# /redoc and /openapi.json, and enables the startup guard in app/config.py
# that refuses to boot with placeholder secrets.
ENVIRONMENT=development
DEBUG=false
# Public base URL of this API. Also what the OpenAPI "servers" block advertises,
# so a wrong value here sends generated clients to the wrong host.
API_BASE_URL=http://localhost:8000
STOREFRONT_URL=http://localhost:3000
LOG_LEVEL=INFO

# ---- Database ----
# The driver prefix is mandatory: SQLAlchemy maps a bare postgresql:// to
# psycopg2, which is not installed. Managed hosts hand you a bare URL, so the
# "+asyncpg" has to be added by hand. Drop any ?sslmode= query param too —
# asyncpg rejects it; use ?ssl=require if you need TLS on an external host.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_commerce
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# ---- Redis ----
# Backs the rate limiter, the arq worker queue and the response cache. If this
# is unreachable, every rate-limited endpoint returns 500 (see the note on
# RATE_LIMIT_ENABLED below), so it is not optional in practice.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ---- JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters in production.
JWT_SECRET=CHANGE_ME
# Set to the outgoing secret during a key rotation so tokens signed with the old
# key keep verifying until they expire. Leave blank otherwise.
JWT_SECRET_PREVIOUS=
JWT_KEY_ID=k1
JWT_KEY_ID_PREVIOUS=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Comma-separated email domains allowed to sign in as staff. Empty means no one
# can use the agent console.
AGENT_ALLOWED_DOMAINS=

# ---- WhatsApp / Meta ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Used to verify the X-Hub-Signature-256 on inbound webhooks. Without it a
# forged callback is indistinguishable from a real one.
WHATSAPP_APP_SECRET=CHANGE_ME
# The string you type into Meta's webhook setup form; echoed back on the GET
# verification handshake.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_CATALOG_ID=
WHATSAPP_BUSINESS_ID=
META_GRAPH_VERSION=v21.0
META_GRAPH_URL=https://graph.facebook.com

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25.0
AI_MAX_CONTEXT_TOKENS=3000
AI_SUMMARY_TOKEN_BUDGET=200
# Consecutive failures before the AI path is skipped, and how long it stays
# skipped, so a provider outage degrades replies instead of stalling them.
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ---- Cashfree ----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production. Selects the API host; see Settings.cashfree_base_url.
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=CHANGE_ME
PAYMENT_LINK_TTL_MINUTES=30

# ---- Conversations ----
AGENT_SLA_MINUTES=15
CONVERSATION_REOPEN_HOURS=24

# ---- Commerce rules ----
CURRENCY=INR
CART_TTL_HOURS=24
# Should exceed PAYMENT_LINK_TTL_MINUTES, or stock can be released while a
# customer still has a live payment link.
RESERVATION_TTL_MINUTES=35
RETURN_WINDOW_DAYS=7
ABANDONED_CART_AFTER_HOURS=2
# Percent, extracted out of the GST-inclusive displayed price rather than added
# on top. See app/services/tax.py.
DEFAULT_GST_RATE=18.0
SELLER_GSTIN=
SELLER_LEGAL_NAME=WhatsApp Commerce Pvt Ltd
SELLER_ADDRESS=Bengaluru, Karnataka, India
# Two-digit GST state code; decides CGST+SGST vs IGST on every invoice.
SELLER_STATE_CODE=29

# ---- Security ----
# Comma-separated. Must not be "*" in production, and must not be empty.
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576
MAX_WEBHOOK_BODY_BYTES=5242880
# Defence in depth on top of signature verification. Both provider IP lists are
# comma-separated CIDRs and change without notice, so this stays off by default.
WEBHOOK_IP_WHITELIST_ENABLED=false
META_WEBHOOK_IPS=
CASHFREE_WEBHOOK_IPS=
ENABLE_HSTS=true

# ---- Rate limits ----
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_COUPON=5/minute
RATE_LIMIT_STORE=60/minute
RATE_LIMIT_ADMIN=120/minute
RATE_LIMIT_WEBHOOK=1000/minute
# Set false to run without Redis. Note that with this true and Redis
# unreachable, slowapi raises before it records the header state and every
# limited endpoint 500s — so turn it off rather than leaving Redis missing.
RATE_LIMIT_ENABLED=true

# ---- Email ----
EMAIL_ENABLED=false
EMAIL_FROM=orders@example.com
EMAIL_FROM_NAME=WhatsApp Commerce
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- Pagination ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
